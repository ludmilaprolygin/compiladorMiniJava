.DATA
VT@NodoGrafo: DW lbl_conectar@NodoGrafo
DW lbl_setVisitado@NodoGrafo
DW lbl_fueVisitado@NodoGrafo
DW lbl_getId@NodoGrafo
.CODE
lbl_conectar@NodoGrafo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 5; cargar parametro (n1)
LOAD 3
SWAP
STOREREF 4; asignacion a atributo (vecino1)
LOAD 4; cargar parametro (n2)
LOAD 3
SWAP
STOREREF 5; asignacion a atributo (vecino2)
lbl_end_conectar@NodoGrafo: NOP
STOREFP; restaurar FP
RET 3

lbl_setVisitado@NodoGrafo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4; cargar parametro (b)
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (visitado)
lbl_end_setVisitado@NodoGrafo: NOP
STOREFP; restaurar FP
RET 2

lbl_fueVisitado@NodoGrafo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 3; acceso a atributo (visitado)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_fueVisitado@NodoGrafo: NOP
STOREFP; restaurar FP
RET 1

lbl_getId@NodoGrafo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (id)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getId@NodoGrafo: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@NodoGrafo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@NodoGrafo: DW "NodoGrafo",0
.CODE
PUSH className@NodoGrafo
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (id)
PUSH 0
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (visitado)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 4; asignacion a atributo (vecino1)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 5; asignacion a atributo (vecino2)
STOREFP; restaurar FP
RET 2



