.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 5; reservar espacio para variables locales (5)
RMEM 1
PUSH 6
PUSH simple_malloc
CALL
DUP
PUSH VT@NodoGrafo
STOREREF 0
DUP
PUSH 1
SWAP
PUSH lbl_builder@NodoGrafo
CALL
STORE 0; almacenar variable local (n1)
RMEM 1
PUSH 6
PUSH simple_malloc
CALL
DUP
PUSH VT@NodoGrafo
STOREREF 0
DUP
PUSH 2
SWAP
PUSH lbl_builder@NodoGrafo
CALL
STORE -1; almacenar variable local (n2)
RMEM 1
PUSH 6
PUSH simple_malloc
CALL
DUP
PUSH VT@NodoGrafo
STOREREF 0
DUP
PUSH 3
SWAP
PUSH lbl_builder@NodoGrafo
CALL
STORE -2; almacenar variable local (n3)
RMEM 1
PUSH 6
PUSH simple_malloc
CALL
DUP
PUSH VT@NodoGrafo
STOREREF 0
DUP
PUSH 4
SWAP
PUSH lbl_builder@NodoGrafo
CALL
STORE -3; almacenar variable local (n4)
LOAD 0; cargar variable local (n1)
LOAD -1; cargar variable local (n2)
SWAP
LOAD -2; cargar variable local (n3)
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (conectar)
CALL
LOAD -1; cargar variable local (n2)
LOAD -3; cargar variable local (n4)
SWAP
PUSH 0; valor null
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (conectar)
CALL
LOAD -2; cargar variable local (n3)
LOAD -3; cargar variable local (n4)
SWAP
PUSH 0; valor null
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (conectar)
CALL
LOAD -3; cargar variable local (n4)
LOAD 0; cargar variable local (n1)
SWAP
PUSH 0; valor null
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (conectar)
CALL
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Grafo
STOREREF 0
DUP
PUSH lbl_builder@Grafo
CALL
STORE -4; almacenar variable local (g)
LOAD -4; cargar variable local (g)
LOAD 0; cargar variable local (n1)
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (dfs)
CALL
.DATA
lblString@221: DW "Fin del recorrido",0
.CODE
PUSH lblString@221
PUSH lbl_printSln@System
CALL
FMEM 5; liberar espacio de variables locales (5)
lbl_end_main@Main: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Character: DW lbl_charValue@Character
.CODE
lbl_charValue@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (value)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_charValue@Character: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Character: DW "Character",0
.CODE
PUSH className@Character
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



