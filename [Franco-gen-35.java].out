lbl_builder@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Arbol
STOREREF 0
DUP
PUSH lbl_builder@Arbol
CALL
STORE 0
LOAD 0
PUSH 50
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 30
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 20
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 40
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 70
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 60
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
PUSH 80
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (insertar)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (imprimir)
CALL
lbl_end_main@Main: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
