.DATA
VT@Arbol: DW lbl_insertar@Arbol
DW lbl_insertarRec@Arbol
DW lbl_imprimir@Arbol
DW lbl_imprimirRec@Arbol
.CODE
lbl_insertar@Arbol: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
PUSH0; valor null
EQ
BF lbl_else@97
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
LOAD 4
SWAP
DUP
PUSH lbl_builder@Nodo
CALL
LOAD 3
SWAP
STOREREF 1
JUMP lbl_fin_if@97
lbl_else@97: NOP
LOAD 3
LOAD 3
LOADREF 1
SWAP
LOAD 4
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (insertarRec)
CALL
lbl_fin_if@97: NOP
lbl_end_insertar@Arbol: NOP
STOREFP; restaurar FP
RET 2

lbl_insertarRec@Arbol: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 5
LOADREF 1; acceso a atributo (valor)
LT
BF lbl_else@105
LOAD 5
LOADREF 2; acceso a atributo (izq)
PUSH0; valor null
EQ
BF lbl_else@106
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
LOAD 4
SWAP
DUP
PUSH lbl_builder@Nodo
CALL
STORE 5
LOADREF 2; acceso a atributo (izq)
JUMP lbl_fin_if@106
lbl_else@106: NOP
LOAD 3
LOAD 5
LOADREF 2; acceso a atributo (izq)
SWAP
LOAD 4
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (insertarRec)
CALL
lbl_fin_if@106: NOP
JUMP lbl_fin_if@105
lbl_else@105: NOP
LOAD 5
LOADREF 3; acceso a atributo (der)
PUSH0; valor null
EQ
BF lbl_else@112
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
LOAD 4
SWAP
DUP
PUSH lbl_builder@Nodo
CALL
STORE 5
LOADREF 3; acceso a atributo (der)
JUMP lbl_fin_if@112
lbl_else@112: NOP
LOAD 3
LOAD 5
LOADREF 3; acceso a atributo (der)
SWAP
LOAD 4
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (insertarRec)
CALL
lbl_fin_if@112: NOP
lbl_fin_if@105: NOP
lbl_end_insertarRec@Arbol: NOP
STOREFP; restaurar FP
RET 3

lbl_imprimir@Arbol: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOAD 3
LOADREF 1
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (imprimirRec)
CALL
lbl_end_imprimir@Arbol: NOP
STOREFP; restaurar FP
RET 1

lbl_imprimirRec@Arbol: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
PUSH0; valor null
NE
BF lbl_fin_if@125
LOAD 3
LOAD 4
LOADREF 2; acceso a atributo (izq)
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (imprimirRec)
CALL
LOAD 4
LOADREF 1; acceso a atributo (valor)
PUSH lbl_printIln@System
CALL
LOAD 3
LOAD 4
LOADREF 3; acceso a atributo (der)
SWAP
DUP
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (imprimirRec)
CALL
lbl_fin_if@125: NOP
lbl_end_imprimirRec@Arbol: NOP
STOREFP; restaurar FP
RET 2

lbl_builder@Arbol: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH0; valor null
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@System: NOP
.CODE
lbl_read@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
READ
PUSH 48
SUB
STORE 3
lbl_end_read@System: NOP
STOREFP; restaurar FP
RET 0

