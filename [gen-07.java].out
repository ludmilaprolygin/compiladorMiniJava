.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Init
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
IPRINT
lbl_end_debugPrint@Object: NOP
STOREFP
RET 1

lbl_builder@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@D: DW lbl_getE@D
.CODE
lbl_getE@D: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@E
STOREREF 0
DUP
PUSH lbl_builder@E
CALL
STORE 3
JUMP lbl_end_getE@D
STORE 0
lbl_end_getE@D: NOP
STOREFP
RET 1

lbl_builder@D: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



