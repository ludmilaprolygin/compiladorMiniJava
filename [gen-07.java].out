STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@D
STOREREF 0
DUP
PUSH lbl_builder@D
CALL
STORE 0
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP
LOADREF 0
LOADREF 0
CALL
RMEM 1; reservar lugar para el retorno
SWAP
DUP
LOADREF 0
LOADREF 0
CALL
STORE -1
LOAD -1
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@Init: NOP
FMEM 2
STOREFP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@Character: DW lbl_charValue@Character
.CODE
lbl_charValue@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 3
JUMP lbl_end_charValue@Character
STORE 0
lbl_end_charValue@Character: NOP
STOREFP
RET 1

lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 2



