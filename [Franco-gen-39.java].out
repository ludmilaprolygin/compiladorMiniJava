.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
IPRINT
lbl_end_debugPrint@Object: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@Integer: DW lbl_intValue@Integer
.CODE
lbl_intValue@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_intValue@Integer: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 2



