.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Mascota
STOREREF 0
.DATA
lblString@75: DW "Fido",0
.CODE
PUSH lblString@75
SWAP
PUSH 4
SWAP
DUP
PUSH lbl_builder@Mascota
CALL
STORE 0
.DATA
lblString@78: DW "Nombre: ",0
.CODE
PUSH lblString@78
PUSH lbl_printS@System
CALL
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (getNombre)
CALL
PUSH lbl_printSln@System
CALL
.DATA
lblString@80: DW "Edad: ",0
.CODE
PUSH lblString@80
PUSH lbl_printS@System
CALL
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getEdad)
CALL
PUSH lbl_printIln@System
CALL
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Mascota
STOREREF 0
.DATA
lblString@84: DW "Luna",0
.CODE
PUSH lblString@84
SWAP
PUSH 2
SWAP
DUP
PUSH lbl_builder@Mascota
CALL
STORE -1
.DATA
lblString@86: DW "---",0
.CODE
PUSH lblString@86
PUSH lbl_printSln@System
CALL
.DATA
lblString@87: DW "Nombre: ",0
.CODE
PUSH lblString@87
PUSH lbl_printS@System
CALL
LOAD -1
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (getNombre)
CALL
PUSH lbl_printSln@System
CALL
.DATA
lblString@89: DW "Edad: ",0
.CODE
PUSH lblString@89
PUSH lbl_printS@System
CALL
LOAD -1
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getEdad)
CALL
PUSH lbl_printIln@System
CALL
.DATA
lblString@92: DW "--------------------",0
.CODE
PUSH lblString@92
PUSH lbl_printSln@System
CALL
lbl_end_main@Main: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



