.DATA
VT@Mascota: DW lbl_getNombre@Mascota
DW lbl_getEdad@Mascota
.CODE
lbl_getNombre@Mascota: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getNombre@Mascota: NOP
STOREFP; restaurar FP
RET 1

lbl_getEdad@Mascota: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getEdad@Mascota: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Mascota: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
LOAD 5
LOAD 3
SWAP
STOREREF 2
STOREFP; restaurar FP
RET 3



.DATA
VT@String: NOP
