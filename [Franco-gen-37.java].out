.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Lista: DW lbl_agregar@Lista
DW lbl_imprimir@Lista
.CODE
lbl_agregar@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
DUP
LOAD 4; cargar parametro (v)
SWAP
PUSH lbl_builder@Nodo
CALL
STORE 0; almacenar variable local (nuevoNodo)
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
PUSH 0; valor null
EQ
BF lbl_else@91
LOAD 0; cargar variable local (nuevoNodo)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (cabeza)
JUMP lbl_fin_if@91
lbl_else@91: NOP
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
STORE 0; almacenar variable local (actual)
lbl_while_inicio@98: NOP
LOAD 0; cargar variable local (actual)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; dupli