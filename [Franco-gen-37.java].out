.DATA
VT@Lista: DW lbl_toString@Object
DW lbl_agregar@Lista
DW lbl_imprimir@Lista
.CODE
lbl_agregar@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
DUP
LOAD 4; cargar parametro (v)
SWAP
PUSH lbl_builder@Nodo
CALL
STORE 0; almacenar variable local (nuevoNodo)
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
PUSH 0; valor null
EQ
BF lbl_else@171
LOAD 0; cargar variable local (nuevoNodo)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (cabeza)
JUMP lbl_fin_if@171
lbl_else@171: NOP
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
STORE -1; almacenar variable local (actual)
lbl_while_inicio@178: NOP
LOAD -1; cargar variable local (actual)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getSiguiente)
CALL
PUSH 0; valor null
NE
BF lbl_while_fin@178
LOAD -1; cargar variable local (actual)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getSiguiente)
CALL
STORE -1; almacenar variable local (actual)
JUMP lbl_while_inicio@178
lbl_while_fin@178: NOP
LOAD -1; cargar variable local (actual)
LOAD 0; cargar variable local (nuevoNodo)
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (setSiguiente)
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_fin_if@171: NOP
FMEM 1; liberar espacio de variables locales (1)
lbl_end_agregar@Lista: NOP
STOREFP; restaurar FP
RET 2

lbl_imprimir@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
STORE 0; almacenar variable local (actual)
lbl_while_inicio@189: NOP
LOAD 0; cargar variable local (actual)
PUSH 0; valor null
NE
BF lbl_while_fin@189
LOAD 0; cargar variable local (actual)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (getValor)
CALL
PUSH lbl_printIln@System
CALL
LOAD 0; cargar variable local (actual)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getSiguiente)
CALL
STORE 0; almacenar variable local (actual)
JUMP lbl_while_inicio@189
lbl_while_fin@189: NOP
FMEM 1; liberar espacio de variables locales (1)
lbl_end_imprimir@Lista: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Lista: DW "Lista",0
.CODE
PUSH className@Lista
LOAD 3
SWAP
STOREREF 1
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (cabeza)
STOREFP; restaurar FP
RET 1



.DATA
VT@Main: DW lbl_toString@Object
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Lista
STOREREF 0
DUP
PUSH lbl_builder@Lista
CALL
STORE 0; almacenar variable local (miLista)
LOAD 0; cargar variable local (miLista)
PUSH 10
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (agregar)
CALL
LOAD 0; cargar variable local (miLista)
PUSH 20
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (agregar)
CALL
LOAD 0; cargar variable local (miLista)
PUSH 30
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (agregar)
CALL
.DATA
lblString@206: DW "Imprimiendo lista:",0
.CODE
PUSH lblString@206
PUSH lbl_printSln@System
CALL
LOAD 0; cargar variable local (miLista)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (imprimir)
CALL
.DATA
lblString@209: DW "--------------------",0
.CODE
PUSH lblString@209
PUSH lbl_printSln@System
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_end_main@Main: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



