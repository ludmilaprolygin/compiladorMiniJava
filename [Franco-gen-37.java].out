.DATA
VT@Nodo: DW lbl_getSiguiente@Nodo
DW lbl_setSiguiente@Nodo
DW lbl_getValor@Nodo
.CODE
lbl_getSiguiente@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getSiguiente@Nodo: NOP
STOREFP; restaurar FP
RET 1

lbl_setSiguiente@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 2
lbl_end_setSiguiente@Nodo: NOP
STOREFP; restaurar FP
RET 2

lbl_getValor@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getValor@Nodo: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
PUSH0; valor null
LOAD 3
SWAP
STOREREF 2
STOREFP; restaurar FP
RET 2



