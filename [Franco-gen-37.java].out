.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Lista: DW lbl_agregar@Lista
DW lbl_imprimir@Lista
.CODE
lbl_agregar@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
LOAD 4
SWAP
DUP
PUSH lbl_builder@Nodo
CALL
STORE 0
LOAD 3
LOADREF 1
PUSH0; valor null
EQ
BF lbl_else@133
LOAD 0
LOAD 3
SWAP
STOREREF 1
JUMP lbl_fin_if@133
lbl_else@133: NOP
LOAD 3
LOADREF 1
STORE 0
lbl_while_inicio@140: NOP
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (getSiguiente)
CALL
PUSH0; valor null
NE
BF lbl_while_fin@140
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (getSiguiente)
CALL
STORE 0
JUMP lbl_while_inicio@140
lbl_while_fin@140: NOP
LOAD 0
LOAD 0
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (setSiguiente)
CALL
lbl_fin_if@133: NOP
lbl_end_agregar@Lista: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 2

lbl_imprimir@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 1
STORE 0
lbl_while_inicio@151: NOP
LOAD 0
PUSH0; valor null
NE
BF lbl_while_fin@151
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (getValor)
CALL
PUSH lbl_printIln@System
CALL
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (getSiguiente)
CALL
STORE 0
JUMP lbl_while_inicio@151
lbl_while_fin@151: NOP
lbl_end_imprimir@Lista: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 1

lbl_builder@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH0; valor null
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



