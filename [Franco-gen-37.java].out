.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Nodo: DW lbl_getSiguiente@Nodo
DW lbl_setSiguiente@Nodo
DW lbl_getValor@Nodo
.CODE
lbl_getSiguiente@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 3; acceso a atributo (siguiente)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getSiguiente@Nodo: NOP
STOREFP; restaurar FP
RET 1

lbl_setSiguiente@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4; cargar parametro (s)
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (siguiente)
lbl_end_setSiguiente@Nodo: NOP
STOREFP; restaurar FP
RET 2

lbl_getValor@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (valor)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getValor@Nodo: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Nodo: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Nodo: DW "Nodo",0
.CODE
PUSH className@Nodo
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (valor)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (siguiente)
STOREFP; restaurar FP
RET 2



.DATA
VT@Lista: DW lbl_agregar@Lista
DW lbl_imprimir@Lista
.CODE
lbl_agregar@Lista: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Nodo
STOREREF 0
DUP
LOAD 4; cargar parametro (v)
SWAP
PUSH lbl_builder@Nodo
CALL
STORE 0; almacenar variable local (nuevoNodo)
LOAD 3
LOADREF 2; acceso a atributo (cabeza)
PUSH 0; valor null
EQ
BF lbl_else@91
LOAD 0; cargar variable local (nuevoNod