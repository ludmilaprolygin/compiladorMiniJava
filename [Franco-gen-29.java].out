.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Character: DW lbl_charValue@Character
.CODE
lbl_charValue@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_charValue@Character: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 2



.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@DList
STOREREF 0
DUP
PUSH lbl_builder@DList
CALL
STORE 0
LOAD 0
PUSH 10
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (add)
CALL
LOAD 0
PUSH 20
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (add)
CALL
LOAD 0
PUSH 30
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (add)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (imprimirIda)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (imprimirVuelta)
CALL
lbl_end_main@Main: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@DList: DW lbl_add@DList
DW lbl_imprimirIda@DList
DW lbl_imprimirVuelta@DList
.CODE
lbl_add@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@Node
STOREREF 0
LOAD 4
SWAP
DUP
PUSH lbl_builder@Node
CALL
STORE 0
LOAD 3
LOADREF 1
PUSH0; valor null
EQ
BF lbl_else@111
LOAD 0
LOAD 3
SWAP
STOREREF 1
LOAD 0
LOAD 3
SWAP
STOREREF 2
JUMP lbl_fin_if@111
lbl_else@111: NOP
LOAD 0
LOAD 3
SWAP
STOREREF 2
LOADREF 2; acceso a atributo (next)
LOAD 3
LOADREF 2
STORE 0
LOADREF 3; acceso a atributo (prev)
LOAD 0
LOAD 3
SWAP
STOREREF 2
lbl_fin_if@111: NOP
lbl_end_add@DList: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 2

lbl_imprimirIda@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 1
STORE 0
.DATA
lblString@127: DW "Ida: ",0
.CODE
PUSH lblString@127
PUSH lbl_printS@System
CALL
lbl_while_inicio@128: NOP
LOAD 0
PUSH0; valor null
NE
BF lbl_while_fin@128
LOAD 0
LOADREF 1; acceso a atributo (val)
PUSH lbl_printI@System
CALL
.DATA
lblString@130: DW " ",0
.CODE
PUSH lblString@130
PUSH lbl_printS@System
CALL
LOAD 0
LOADREF 2; acceso a atributo (next)
STORE 0
JUMP lbl_while_inicio@128
lbl_while_fin@128: NOP
.DATA
lblString@133: DW " ",0
.CODE
PUSH lblString@133
PUSH lbl_printSln@System
CALL
lbl_end_imprimirIda@DList: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 1

lbl_imprimirVuelta@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 2
STORE 0
.DATA
lblString@139: DW "Vuelta: ",0
.CODE
PUSH lblString@139
PUSH lbl_printS@System
CALL
lbl_while_inicio@140: NOP
LOAD 0
PUSH0; valor null
NE
BF lbl_while_fin@140
LOAD 0
LOADREF 1; acceso a atributo (val)
PUSH lbl_printI@System
CALL
.DATA
lblString@142: DW " ",0
.CODE
PUSH lblString@142
PUSH lbl_printS@System
CALL
LOAD 0
LOADREF 3; acceso a atributo (prev)
STORE 0
JUMP lbl_while_inicio@140
lbl_while_fin@140: NOP
.DATA
lblString@145: DW " ",0
.CODE
PUSH lblString@145
PUSH lbl_printSln@System
CALL
lbl_end_imprimirVuelta@DList: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 1

lbl_builder@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH0; valor null
LOAD 3
SWAP
STOREREF 1
PUSH0; valor null
LOAD 3
SWAP
STOREREF 2
STOREFP; restaurar FP
RET 1



