.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Main: DW lbl_toString@Object
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 4
PUSH simple_malloc
CALL
DUP
PUSH VT@DList
STOREREF 0
DUP
PUSH lbl_builder@DList
CALL
STORE 0; almacenar variable local (lista)
LOAD 0; cargar variable local (lista)
PUSH 10
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (add)
CALL
LOAD 0; cargar variable local (lista)
PUSH 20
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (add)
CALL
LOAD 0; cargar variable local (lista)
PUSH 30
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (add)
CALL
LOAD 0; cargar variable local (lista)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (imprimirIda)
CALL
LOAD 0; cargar variable local (lista)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (imprimirVuelta)
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_end_main@Main: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Object: DW lbl_toString@Object
.CODE
