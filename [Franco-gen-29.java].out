.DATA
VT@Node: DW lbl_toString@Object
.CODE
lbl_builder@Node: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Node: DW "Node",0
.CODE
PUSH className@Node
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (val)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (next)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 4; asignacion a atributo (prev)
STOREFP; restaurar FP
RET 2



.DATA
VT@DList: DW lbl_toString@Object
DW lbl_add@DList
DW lbl_imprimirIda@DList
DW lbl_imprimirVuelta@DList
.CODE
lbl_add@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 5
PUSH simple_malloc
CALL
DUP
PUSH VT@Node
STOREREF 0
DUP
LOAD 4; cargar parametro (v)
SWAP
PUSH lbl_builder@Node
CALL
STORE 0; almacenar variable local (nuevo)
LOAD 3
LOADREF 2; acceso a atributo (head)
PUSH 0; valor null
EQ
BF lbl_else@155
LOAD 0; cargar variable local (nuevo)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (head)
LOAD 0; cargar variable local (nuevo)
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (tail)
JUMP lbl_fin_if@155
lbl_else@155: NOP
LOAD 0; cargar variable local (nuevo)
LOAD 3
LOADREF 3; acceso a atributo (tail)
SWAP
STOREREF 3; asignacion a atributo (next)
LOAD 3
LOADREF 3; acceso a atributo (tail)
LOAD 0; cargar variable local (nuevo)
SWAP
STOREREF 4; asignacion a atributo (prev)
LOAD 0; cargar variable local (nuevo)
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (tail)
lbl_fin_if@155: NOP
FMEM 1; liberar espacio de variables locales (1)
lbl_end_add@DList: NOP
STOREFP; restaurar FP
RET 2

lbl_imprimirIda@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 2; acceso a atributo (head)
STORE 0; almacenar variable local (p)
.DATA
lblString@171: DW "Ida: ",0
.CODE
PUSH lblString@171
PUSH lbl_printS@System
CALL
lbl_while_inicio@172: NOP
LOAD 0; cargar variable local (p)
PUSH 0; valor null
NE
BF lbl_while_fin@172
LOAD 0; cargar variable local (p)
LOADREF 2; acceso a atributo (val)
PUSH lbl_printI@System
CALL
.DATA
lblString@174: DW " ",0
.CODE
PUSH lblString@174
PUSH lbl_printS@System
CALL
LOAD 0; cargar variable local (p)
LOADREF 3; acceso a atributo (next)
STORE 0; almacenar variable local (p)
JUMP lbl_while_inicio@172
lbl_while_fin@172: NOP
.DATA
lblString@177: DW " ",0
.CODE
PUSH lblString@177
PUSH lbl_printSln@System
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_end_imprimirIda@DList: NOP
STOREFP; restaurar FP
RET 1

lbl_imprimirVuelta@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
LOAD 3
LOADREF 3; acceso a atributo (tail)
STORE 0; almacenar variable local (p)
.DATA
lblString@183: DW "Vuelta: ",0
.CODE
PUSH lblString@183
PUSH lbl_printS@System
CALL
lbl_while_inicio@184: NOP
LOAD 0; cargar variable local (p)
PUSH 0; valor null
NE
BF lbl_while_fin@184
LOAD 0; cargar variable local (p)
LOADREF 2; acceso a atributo (val)
PUSH lbl_printI@System
CALL
.DATA
lblString@186: DW " ",0
.CODE
PUSH lblString@186
PUSH lbl_printS@System
CALL
LOAD 0; cargar variable local (p)
LOADREF 4; acceso a atributo (prev)
STORE 0; almacenar variable local (p)
JUMP lbl_while_inicio@184
lbl_while_fin@184: NOP
.DATA
lblString@189: DW " ",0
.CODE
PUSH lblString@189
PUSH lbl_printSln@System
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_end_imprimirVuelta@DList: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@DList: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@DList: DW "DList",0
.CODE
PUSH className@DList
LOAD 3
SWAP
STOREREF 1
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (head)
PUSH 0; valor null
LOAD 3
SWAP
STOREREF 3; asignacion a atributo (tail)
STOREFP; restaurar FP
RET 1



