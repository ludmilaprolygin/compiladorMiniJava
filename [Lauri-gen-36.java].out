.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 5
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0; almacenar variable local (a)
LOAD 0; cargar variable local (a)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (md)
CALL
LOAD 0; cargar variable local (a)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (mc)
CALL
FMEM 1; liberar espacio de variables locales (1)
lbl_end_main@Init: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Init: DW "Init",0
.CODE
PUSH className@Init
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



