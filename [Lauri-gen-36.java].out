.DATA
VT@Integer: DW lbl_intValue@Integer
.CODE
lbl_intValue@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (value)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_intValue@Integer: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Integer: DW "Integer",0
.CODE
PUSH className@Integer
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



.DATA
VT@A: DW lbl_mc@A
DW lbl_md@A
.CODE
lbl_mc@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 0
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (b)
lbl_while_inicio@100: NOP
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH 3
LT
BF lbl_while_fin@100
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH 1
ADD
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (b)
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH lbl_debugPrint@Object
CALL
JUMP lbl_while_inicio@100
lbl_while_fin@100: NOP
PUSH 10
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (b)
lbl_while_inicio@105: NOP
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH 8
GT
BF lbl_while_fin@105
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH 1
SUB
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (b)
LOAD 3
LOADREF 2; acceso a atributo (b)
PUSH lbl_debugPrint@Object
CALL
JUMP lbl_while_inicio@105
lbl_while_fin@105: NOP
lbl_end_mc@A: NOP
STOREFP; restaurar FP
RET 1

lbl_md@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 3; reservar espacio para variables locales (3)
PUSH 10
STORE 0; almacenar variable local (x)
LOAD 0; cargar variable local (x)
PUSH 10
EQ
BF lbl_fin_if@113
LOAD 0; cargar variable local (x)
PUSH lbl_debugPrint@Object
CALL
lbl_fin_if@113: NOP
PUSH 12
STORE -1; almacenar variable local (y)
LOAD -1; cargar variable local (y)
PUSH 12
EQ
BF lbl_fin_if@117
LOAD -1; cargar variable local (y)
PUSH lbl_debugPrint@Object
CALL
lbl_fin_if@117: NOP
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
ADD
STORE -2; almacenar variable local (z)
LOAD -2; cargar variable local (z)
PUSH lbl_debugPrint@Object
CALL
FMEM 3; liberar espacio de variables locales (3)
lbl_end_md@A: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@A: DW "A",0
.CODE
PUSH className@A
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



