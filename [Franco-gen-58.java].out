.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@TestIfReturn
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@String: DW "String",0
.CODE
PUSH className@String
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@TestIfReturn: NOP
.CODE
lbl_max@TestIfReturn: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4; cargar parametro (a)
LOAD 3; cargar parametro (b)
GT
BF lbl_fin_if@60
LOAD 4; cargar parametro (a)
STORE 5; guardar valor de retorno
STOREFP; restaurar FP
RET 2
lbl_fin_if@60: NOP
LOAD 3; cargar parametro (b)
STORE 5; guardar valor de retorno
STOREFP; restaurar FP
RET 2
lbl_end_max@TestIfReturn: NOP
STOREFP; restaurar FP
RET 2

lbl_main@TestIfReturn: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar lugar para el retorno
PUSH 10
PUSH 3
PUSH lbl_max@TestIfReturn
CALL
PUSH lbl_debugPrint@Object
CALL
RMEM 1; reservar lugar para el retorno
PUSH 2
PUSH 7
PUSH lbl_max@TestIfReturn
CALL
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@TestIfReturn: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@TestIfReturn: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@TestIfReturn: DW "TestIfReturn",0
.CODE
PUSH className@TestIfReturn
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Integer: DW lbl_intValue@Integer
.CODE
lbl_intValue@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (value)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_intValue@Integer: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Integer: DW "Integer",0
.CODE
PUSH className@Integer
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



