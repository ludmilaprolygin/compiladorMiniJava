.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Init8
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@String: DW "String",0
.CODE
PUSH className@String
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@System: NOP
.CODE
lbl_read@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
READ
PUSH 48
SUB
STORE 3
lbl_end_read@System: NOP
STOREFP; restaurar FP
RET 0

