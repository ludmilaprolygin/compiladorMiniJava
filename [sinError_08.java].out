.DATA
VT@Init8: NOP
.CODE
lbl_main@Init8: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 0
PUSH 0
PUSH lbl_m1@Init8
CALL
lbl_end_main@Init8: NOP
STOREFP; restaurar FP
RET 0

lbl_m1@Init8: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4; cargar parametro (p1)
PUSH lbl_printIln@System
CALL
LOAD 4; cargar parametro (p1)
PUSH 1
ADD
STORE 4; almacenar parametro (p1)
LOAD 4; cargar parametro (p1)
PUSH lbl_printIln@System
CALL
LOAD 4; cargar parametro (p1)
PUSH lbl_printIln@System
CALL
LOAD 4; cargar parametro (p1)
PUSH 1
SUB
STORE 4; almacenar parametro (p1)
LOAD 4; cargar parametro (p1)
PUSH lbl_printIln@System
CALL
lbl_end_m1@Init8: NOP
STOREFP; restaurar FP
RET 2

lbl_builder@Init8: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Init8: DW "Init8",0
.CODE
PUSH className@Init8
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



