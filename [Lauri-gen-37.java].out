.DATA
VT@Init: DW lbl_toString@Object
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 3; reservar espacio para variables locales (3)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0; almacenar variable local (a)
LOAD 0; cargar variable local (a)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (m1)
CALL
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@B
STOREREF 0
DUP
PUSH lbl_builder@B
CALL
STORE -1; almacenar variable local (b)
LOAD -1; cargar variable local (b)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (m1)
CALL
LOAD -1; cargar variable local (b)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (m2)
CALL
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@C
STOREREF 0
DUP
PUSH lbl_builder@C
CALL
STORE -2; almacenar variable local (c)
LOAD -2; cargar variable local (c)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (m1)
CALL
LOAD -2; cargar variable local (c)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (m2)
CALL
LOAD -2; cargar variable local (c)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (m3)
CALL
FMEM 3; liberar espacio de variables locales (3)
lbl_end_main@Init: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Init: DW "Init",0
.CODE
PUSH className@Init
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



