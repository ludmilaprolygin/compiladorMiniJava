.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 5
PUSH simple_malloc
CALL
DUP
PUSH VT@C
STOREREF 0
DUP
PUSH lbl_builder@C
CALL
STORE 0; almacenar variable local (miC)
LOAD 0; cargar variable local (miC)
PUSH 1
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 0; cargar metodo (setA)
CALL
LOAD 0; cargar variable local (miC)
PUSH 2
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 1; cargar metodo (setB)
CALL
LOAD 0; cargar variable local (miC)
PUSH 3
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 2; cargar metodo (setC)
CALL
.DATA
lblString@123: DW "---",0
.CODE
PUSH lblString@123
PUSH lbl_printSln@System
CALL
LOAD 0; cargar variable local (miC)
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 3; cargar metodo (imprimirValores)
CALL
.DATA
lblString@125: DW "---",0
.CODE
PUSH lblString@125
PUSH lbl_printSln@System
CALL
LOAD 0; cargar variable local (miC)
PUSH 99
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 1; cargar metodo (setB)
CALL
LOAD 0; cargar variable local (miC)
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 3; cargar metodo (imprimirValores)
CALL
.DATA
lblString@130: DW "---",0
.CODE
PUSH lblString@130
PUSH lbl_printSln@System
CALL
LOAD 0; cargar variable local (miC)
STORE -1; almacenar variable local (miB)
LOAD -1; cargar variable local (miB)
DUP; duplicar this
LOADREF 0; cargar la VT (C)
LOADREF 4; cargar metodo (imprimir)
CALL
.DATA
lblString@135: DW "--------------------",0
.CODE
PUSH lblString@135
PUSH lbl_printSln@System
CALL
lbl_end_main@Main: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



