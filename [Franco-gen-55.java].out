STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



.DATA
VT@TestAdder: NOP
.CODE
lbl_main@TestAdder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
PUSH 1
PUSH lbl_printIln@System
CALL
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Adder
STOREREF 0
DUP
PUSH 10
SWAP
PUSH 20
SWAP
PUSH lbl_builder@Adder
CALL
STORE 0; almacenar variable local (a1)
LOAD 0; cargar variable local (a1)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (sumar)
CALL
PUSH lbl_printIln@System
CALL
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Adder
STOREREF 0
DUP
PUSH 50
SWAP
PUSH 50
SWAP
PUSH lbl_builder@Adder
CALL
STORE -1; almacenar variable local (a2)
LOAD -1; cargar variable local (a2)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (sumar)
CALL
PUSH lbl_printIln@System
CALL
PUSH 2
PUSH lbl_printIln@System
CALL
FMEM 2; liberar espacio de variables locales (2)
lbl_end_main@TestAdder: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@TestAdder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@TestAdder: DW "TestAdder",0
.CODE
PUSH className@TestAdder
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Adder: DW lbl_sumar@Adder
.CODE
lbl_sumar@Adder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (total)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_sumar@Adder: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Adder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Adder: DW "Adder",0
.CODE
PUSH className@Adder
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (a)
LOAD 5; cargar parametro (b)
ADD
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (total)
STOREFP; restaurar FP
RET 3



