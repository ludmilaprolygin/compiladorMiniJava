lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 2



.DATA
VT@TestAdder: NOP
.CODE
lbl_main@TestAdder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
PUSH 1
PUSH lbl_printIln@System
CALL
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Adder
STOREREF 0
PUSH 10
SWAP
PUSH 20
SWAP
DUP
PUSH lbl_builder@Adder
CALL
STORE 0
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (sumar)
CALL
PUSH lbl_printIln@System
CALL
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Adder
STOREREF 0
PUSH 50
SWAP
PUSH 50
SWAP
DUP
PUSH lbl_builder@Adder
CALL
STORE -1
LOAD -1
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (sumar)
CALL
PUSH lbl_printIln@System
CALL
PUSH 2
PUSH lbl_printIln@System
CALL
lbl_end_main@TestAdder: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@TestAdder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
