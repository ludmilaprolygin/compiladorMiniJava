.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@TestAdder
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@System: NOP
.CODE
lbl_read@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
READ
PUSH 48
SUB
STORE 3
lbl_end_read@System: NOP
STOREFP; restaurar FP
RET 0

lbl_printB@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
BPRINT
lbl_end_printB@System: NOP
STOREFP; restaurar FP
RET 1

lbl_printC@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
CPRINT
lbl_end_printC@System: NOP
STOREFP; restaurar FP
RET 1

lbl_printI@System: 
