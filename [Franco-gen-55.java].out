lbl_builder@System: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@Boolean: DW lbl_booleanValue@Boolean
.CODE
lbl_booleanValue@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_booleanValue@Boolean: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 2



.DATA
VT@Adder: DW lbl_sumar@Adder
.CODE
lbl_sumar@Adder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_sumar@Adder: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Adder: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 5
ADD
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 3



