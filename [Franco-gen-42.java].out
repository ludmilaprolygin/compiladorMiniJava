.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
IPRINT
lbl_end_debugPrint@Object: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Object: DW "Object",0
.CODE
PUSH className@Object
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Boolean: DW lbl_booleanValue@Boolean
.CODE
lbl_booleanValue@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (value)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_booleanValue@Boolean: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Boolean: DW "Boolean",0
.CODE
PUSH className@Boolean
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Counter
STOREREF 0
DUP
PUSH lbl_builder@Counter
CALL
STORE 0; almacenar variable local (c)
lbl_while_inicio@90: NOP
LOAD 0; cargar variable local (c)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getCount)
CALL
PUSH 15
LT
BF lbl_while_fin@90
LOAD 0; cargar variable local (c)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (increment)
CALL
LOAD 0; cargar variable local (c)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (getCount)
CALL
PUSH lbl_printIln@System
CALL
JUMP lbl_while_inicio@90
lbl_while_fin@90: NOP
FMEM 1; liberar espacio de variables locales (1)
lbl_end_main@Main: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



