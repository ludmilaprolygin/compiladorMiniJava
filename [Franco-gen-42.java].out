.DATA
VT@Counter: DW lbl_increment@Counter
DW lbl_getCount@Counter
.CODE
lbl_increment@Counter: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (count)
PUSH 3
ADD
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (count)
lbl_end_increment@Counter: NOP
STOREFP; restaurar FP
RET 1

lbl_getCount@Counter: 
