.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Nivel1
STOREREF 0
DUP
PUSH lbl_builder@Nivel1
CALL
STORE 0; almacenar variable local (base)
PUSH 500
LOAD 0; cargar variable local (base)
LOADREF 2; acceso a atributo (medio)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (Nivel2)
LOADREF 0; cargar metodo (getInterno)
CALL
SWAP
STOREREF 2; asignacion a atributo (valor)
LOAD 0; cargar variable local (base)
LOADREF 2; acceso a atributo (medio)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (Nivel2)
LOADREF 0; cargar metodo (getInterno)
CALL
LOADREF 2; acceso a atributo (valor)
PUSH lbl_debugPrint@Object
CALL
PUSH 1000
LOAD 0; cargar variable local (base)
LOADREF 2; acceso a atributo (medio)
LOADREF 2; acceso a atributo (interno)
SWAP
STOREREF 2; asignacion a atributo (valor)
.DATA
lblString@90: DW "Valor final: ",0
.CODE
PUSH lblString@90
PUSH lbl_printS@System
CALL
LOAD 0; cargar variable local (base)
LOADREF 2; acceso a atributo (medio)
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (Nivel2)
LOADREF 0; cargar metodo (getInterno)
CALL
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (Nivel3)
LOADREF 1; cargar metodo (getValor)
CALL
PUSH lbl_printIln@System
CALL
lbl_end_main@Main: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



