.DATA
VT@Nivel1: NOP
.CODE
lbl_builder@Nivel1: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Nivel1: DW "Nivel1",0
.CODE
PUSH className@Nivel1
LOAD 3
SWAP
STOREREF 1
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@Nivel2
STOREREF 0
DUP
PUSH lbl_builder@Nivel2
CALL
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (medio)
STOREFP; restaurar FP
RET 1



