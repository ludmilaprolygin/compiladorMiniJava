.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Nivel3: DW lbl_setValor@Nivel3
DW lbl_getValor@Nivel3
.CODE
lbl_setValor@Nivel3: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (valor)
lbl_end_setValor@Nivel3: NOP
STOREFP; restaurar FP
RET 2

lbl_getValor@Nivel3: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (valor)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getValor@Nivel3: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Nivel3: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Nivel3: DW "Nivel3",0
.CODE
PUSH className@Nivel3
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



