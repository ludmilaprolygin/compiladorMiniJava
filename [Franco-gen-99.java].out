.DATA
VT@Init: DW lbl_toString@Object
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 5; reservar espacio para variables locales (5)
PUSH 1
STORE 0; almacenar variable local (i)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@B
STOREREF 0
DUP
PUSH lbl_builder@B
CALL
STORE -1; almacenar variable local (x)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@C
STOREREF 0
DUP
PUSH lbl_builder@C
CALL
STORE -2; almacenar variable local (y)
LOAD 0; cargar variable local (i)
BF lbl_else@72
LOAD -1; cargar variable local (x)
JUMP lbl_fin_if@72
lbl_else@72: NOP
LOAD -2; cargar variable local (y)
lbl_fin_if@72: NOP
STORE -3; almacenar variable local (a)
LOAD 0; cargar variable local (i)
NOT
BF lbl_else@73
LOAD -1; cargar variable local (x)
JUMP lbl_fin_if@73
lbl_else@73: NOP
LOAD -2; cargar variable local (y)
lbl_fin_if@73: NOP
STORE -4; almacenar variable local (b)
LOAD -3; cargar variable local (a)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (toString)
CALL
LOAD -4; cargar variable local (b)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (toString)
CALL
FMEM 5; liberar espacio de variables locales (5)
lbl_end_main@Init: NOP
STOREFP; restaurar FP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Init: DW "Init",0
.CODE
PUSH className@Init
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



