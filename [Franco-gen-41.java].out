.DATA
VT@Main: NOP
.CODE
lbl_imprimirRuido@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
DUP; duplicar this
LOADREF 0; cargar la VT (Animal)
LOADREF 0; cargar metodo (hacerRuido)
CALL
lbl_end_imprimirRuido@Main: NOP
STOREFP; restaurar FP
RET 1

lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Animal
STOREREF 0
DUP
PUSH lbl_builder@Animal
CALL
STORE 0
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Perro
STOREREF 0
DUP
PUSH lbl_builder@Perro
CALL
STORE -1
.DATA
lblString@77: DW "Animal dice: ",0
.CODE
PUSH lblString@77
PUSH lbl_printS@System
CALL
LOAD 0
PUSH lbl_imprimirRuido@Main
CALL
.DATA
lblString@82: DW "Perro dice: ",0
.CODE
PUSH lblString@82
PUSH lbl_printS@System
CALL
LOAD -1
PUSH lbl_imprimirRuido@Main
CALL
lbl_end_main@Main: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



