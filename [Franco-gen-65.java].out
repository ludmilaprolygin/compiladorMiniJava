.DATA
VT@TestIf: NOP
.CODE
lbl_main@TestIf: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
PUSH 5
STORE 0
LOAD 0
PUSH 1
ADD
STORE 0
PUSH lbl_printIln@System
CALL
LOAD 0
PUSH 1
SUB
STORE 0
PUSH lbl_printIln@System
CALL
PUSH 5
STORE -1
LOAD 0
LOAD -1
GT
BF lbl_else@54
PUSH 1
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@54
lbl_else@54: NOP
PUSH 2
PUSH lbl_printIln@System
CALL
lbl_fin_if@54: NOP
LOAD 0
LOAD -1
LT
BF lbl_else@60
PUSH 3
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@60
lbl_else@60: NOP
PUSH 4
PUSH lbl_printIln@System
CALL
lbl_fin_if@60: NOP
LOAD 0
LOAD -1
GT
BF lbl_fin_if@66
PUSH 5
PUSH lbl_printIln@System
CALL
lbl_fin_if@66: NOP
PUSH 6
PUSH lbl_printIln@System
CALL
LOAD 0
LOAD -1
LT
BF lbl_fin_if@71
PUSH 7
PUSH lbl_printIln@System
CALL
lbl_fin_if@71: NOP
PUSH 8
PUSH lbl_printIln@System
CALL
LOAD 0
LOAD -1
EQ
BF lbl_fin_if@76
PUSH 9
PUSH lbl_printIln@System
CALL
lbl_fin_if@76: NOP
LOAD 0
PUSH 1
ADD
LOAD -1
PUSH 1
ADD
EQ
BF lbl_else@80
PUSH 10
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@80
lbl_else@80: NOP
PUSH 11
PUSH lbl_printIln@System
CALL
lbl_fin_if@80: NOP
lbl_end_main@TestIf: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@TestIf: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



