.DATA
VT@TestIf: NOP
.CODE
lbl_main@TestIf: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
PUSH 5
STORE 0; almacenar variable local (x)
LOAD 0; cargar variable local (x)
PUSH 1
ADD
DUP
STORE 0; almacenar variable local (x)
PUSH lbl_printIln@System
CALL
LOAD 0; cargar variable local (x)
PUSH 1
SUB
DUP
STORE 0; almacenar variable local (x)
PUSH lbl_printIln@System
CALL
PUSH 5
STORE -1; almacenar variable local (y)
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
GT
BF lbl_else@95
PUSH 1
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@95
lbl_else@95: NOP
PUSH 2
PUSH lbl_printIln@System
CALL
lbl_fin_if@95: NOP
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
LT
BF lbl_else@101
PUSH 3
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@101
lbl_else@101: NOP
PUSH 4
PUSH lbl_printIln@System
CALL
lbl_fin_if@101: NOP
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
GT
BF lbl_fin_if@107
PUSH 5
PUSH lbl_printIln@System
CALL
lbl_fin_if@107: NOP
PUSH 6
PUSH lbl_printIln@System
CALL
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
LT
BF lbl_fin_if@112
PUSH 7
PUSH lbl_printIln@System
CALL
lbl_fin_if@112: NOP
PUSH 8
PUSH lbl_printIln@System
CALL
LOAD 0; cargar variable local (x)
LOAD -1; cargar variable local (y)
EQ
BF lbl_fin_if@117
PUSH 9
PUSH lbl_printIln@System
CALL
lbl_fin_if@117: NOP
LOAD 0; cargar variable local (x)
PUSH 1
ADD
LOAD -1; cargar variable local (y)
PUSH 1
ADD
EQ
BF lbl_else@121
PUSH 10
PUSH lbl_printIln@System
CALL
JUMP lbl_fin_if@121
lbl_else@121: NOP
PUSH 11
PUSH lbl_printIln@System
CALL
lbl_fin_if@121: NOP
lbl_end_main@TestIf: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@TestIf: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@TestIf: DW "TestIf",0
.CODE
PUSH className@TestIf
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



