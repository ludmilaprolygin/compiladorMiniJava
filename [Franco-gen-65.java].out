.DATA
VT@Integer: DW lbl_intValue@Integer
.CODE
lbl_intValue@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_intValue@Integer: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Integer: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 2



