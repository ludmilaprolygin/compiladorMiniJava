.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@TestIf
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@String: DW "String",0
.CODE
PUSH className@String
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Boolean: DW lbl_booleanValue@Boolean
.CODE
lbl_booleanValue@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2; acceso a atributo (value)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_booleanValue@Boolean: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Boolean: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Boolean: DW "Boolean",0
.CODE
PUSH className@Boolean
LOAD 3
SWAP
STOREREF 1
LOAD 4; cargar parametro (v)
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (value)
STOREFP; restaurar FP
RET 2



