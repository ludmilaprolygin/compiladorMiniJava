.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@TestWhile
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 1



.DATA
VT@TestWhile: NOP
.CODE
lbl_main@TestWhile: 
LOADFP
LOADSP
STOREFP
RMEM 2
PUSH 0
STORE 0
PUSH 0
STORE -1
lbl_while_inicio@8: NOP
LOAD 0
PUSH 5
BF lbl_while_fin@8
LOAD 0
LOAD 0
ADD
STORE 0
LOAD 0
PUSH 1
ADD
STORE 0
LOAD 0
PUSH lbl_debugPrint@Object
CALL
JUMP lbl_while_inicio@8
lbl_while_fin@8: NOP
LOAD -1
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@TestWhile: NOP
FMEM 2
STOREFP
RET 0

lbl_builder@TestWhile: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 1



