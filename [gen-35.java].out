JUMP lbl_fin_if@34
lbl_else@34: NOP
PUSH 0
LOAD 3
SWAP
STOREREF 4
lbl_fin_if@34: NOP
PUSH 55
LOAD 3
SWAP
STOREREF 5
lbl_end_seta4@B: NOP
STOREFP
RET 1

