.DATA
VT@B: DW lbl_setall@A
DW lbl_m1@A
DW lbl_seta4@B
DW lbl_m2@B
.CODE
lbl_seta4@B: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 1
BF lbl_else@78
PUSH 4000
LOAD 3
SWAP
STOREREF 5
JUMP lbl_fin_if@78
lbl_else@78: NOP
PUSH 0
LOAD 3
SWAP
STOREREF 5
lbl_fin_if@78: NOP
PUSH 55
LOAD 3
SWAP
STOREREF 6
lbl_end_seta4@B: NOP
STOREFP; restaurar FP
RET 1

lbl_m2@B: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 5
PUSH lbl_debugPrint@Object
CALL
LOAD 3
LOADREF 6
PUSH lbl_debugPrint@Object
CALL
lbl_end_m2@B: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@B: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@B: DW "B",0
.CODE
PUSH className@B
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 7
PUSH simple_malloc
CALL
DUP
PUSH VT@B
STOREREF 0
DUP
PUSH lbl_builder@B
CALL
STORE 0
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (seta4)
CALL
LOAD 0
PUSH 1234
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (setall)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (m1)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 3; cargar metodo (m2)
CALL
lbl_end_main@Init: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Init: DW "Init",0
.CODE
PUSH className@Init
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@A: DW lbl_setall@A
DW lbl_m1@A
.CODE
lbl_setall@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 1
BF lbl_else@55
LOAD 4
LOAD 3
SWAP
STOREREF 2
JUMP lbl_fin_if@55
lbl_else@55: NOP
PUSH 0
LOAD 3
SWAP
STOREREF 2
lbl_fin_if@55: NOP
LOAD 3
LOADREF 2
PUSH 2
MUL
LOAD 3
SWAP
STOREREF 3
.DATA
lblString@61: DW "hola",0
.CODE
PUSH lblString@61
LOAD 3
SWAP
STOREREF 4
lbl_end_setall@A: NOP
STOREFP; restaurar FP
RET 2

lbl_m1@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2
PUSH lbl_debugPrint@Object
CALL
LOAD 3
LOADREF 3
PUSH lbl_debugPrint@Object
CALL
LOAD 3
LOADREF 4
PUSH lbl_printSln@System
CALL
lbl_end_m1@A: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@A: DW "A",0
.CODE
PUSH className@A
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



