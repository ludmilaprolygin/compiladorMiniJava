.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Init
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1
RMEM 1
PUSH 6
PUSH simple_malloc
CALL
DUP
PUSH VT@B
STOREREF 0
DUP
PUSH lbl_builder@B
CALL
STORE 0
LOAD 0
DUP
LOADREF 0
LOADREF 0
CALL
LOAD 0
PUSH 1234
SWAP
DUP
LOADREF 0
LOADREF 2
CALL
LOAD 0
DUP
LOADREF 0
LOADREF 3
CALL
LOAD 0
DUP
LOADREF 0
LOADREF 1
CALL
lbl_end_main@Init: NOP
FMEM 1
STOREFP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@A: DW lbl_setall@A
DW lbl_m1@A
.CODE
lbl_setall@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 1
BF lbl_else@11
LOAD 4
LOAD 3
SWAP
STOREREF 1
JUMP lbl_fin_if@11
lbl_else@11: NOP
PUSH 0
LOAD 3
SWAP
STOREREF 1
lbl_fin_if@11: NOP
LOAD 3
LOADREF 1
PUSH 2
MUL
LOAD 3
SWAP
STOREREF 2
LOAD 3
SWAP
STOREREF 3
lbl_end_setall@A: NOP
STOREFP
RET 2

lbl_m1@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 1
PUSH lbl_debugPrint@Object
CALL
LOAD 3
LOADREF 2
PUSH lbl_debugPrint@Object
CALL
LOAD 3
LOADREF 3
PUSH lbl_printSln@System
CALL
lbl_end_m1@A: NOP
STOREFP
RET 1

lbl_builder@A: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP
RET 1



.DATA
VT@B: DW lbl_seta4@B
DW lbl_m2@B
