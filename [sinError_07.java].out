.DATA
VT@Init7: NOP
.CODE
lbl_main@Init7: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 1
PUSH lbl_m1@Init7
CALL
lbl_end_main@Init7: NOP
STOREFP; restaurar FP
RET 0

lbl_m1@Init7: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
PUSH 0
STORE 3
LOAD 3
PUSH lbl_printBln@System
CALL
LOAD 3
NOT
STORE 3
LOAD 3
PUSH lbl_printBln@System
CALL
lbl_end_m1@Init7: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Init7: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



