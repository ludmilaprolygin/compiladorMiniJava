.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Main
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
IPRINT
lbl_end_debugPrint@Object: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Object: DW "Object",0
.CODE
PUSH className@Object
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 3
PUSH simple_malloc
CALL
DUP
PUSH VT@TestThis
STOREREF 0
DUP
PUSH 10
SWAP
PUSH lbl_builder@TestThis
CALL
STORE 0
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT (TestThis)
LOADREF 2; cargar metodo (imprimirValor)
CALL
LOAD 0
PUSH 20
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT (TestThis)
LOADREF 0; cargar metodo (setValor)
CALL
LOAD 0
DUP; duplicar this
LOADREF 0; cargar la VT (TestThis)
LOADREF 2; cargar metodo (imprimirValor)
CALL
lbl_end_main@Main: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Main: DW "Main",0
.CODE
PUSH className@Main
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Character: DW lbl_charValue@Character
.CODE
lbl_charValue@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_charValue@Character: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Character: DW "Character",0
.CODE
PUSH className@Character
LOAD 3
SWAP
STOREREF 1
LOAD 4
LOAD 3
SWAP
STOREREF 2
STOREFP; restaurar FP
RET 2



.DATA
VT@TestThis: DW lbl_setValor@TestThis
DW lbl_getValor@TestThis
DW lbl_imprimirValor@TestThis
.CODE
lbl_setValor@TestThis: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 4
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (valor)
lbl_end_setValor@TestThis: NOP
STOREFP; restaurar FP
RET 2

lbl_getValor@TestThis: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
SWAP
STOREREF 2; asignacion a atributo (valor)
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_getValor@TestThis: NOP
STOREFP; restaurar FP
RET 1

lbl_imprimirValor@TestThis: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this