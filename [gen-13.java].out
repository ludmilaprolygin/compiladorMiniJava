.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP
LOADSP
STOREFP
RMEM 2
RMEM 1
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
LOADSP
SWAP
STOREREF 03
PUSH lbl_builder@A
CALL
FMEM 1
STORE 0
RMEM 1
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@C
STOREREF 0
DUP
LOADSP
SWAP
STOREREF 03
PUSH lbl_builder@C
CALL
FMEM 1
STORE -1
LOAD 0
DUP
LOADREF 0
LOADREF 0
SWAP
LOAD -1
SWAP
CALL
LOADREF 1
lbl_end_main@Init: NOP
FMEM 2
STOREFP
RET 0

lbl_builder@Init: 
LOADFP
LOADSP
STOREFP
RMEM 0
FMEM 0
STOREFP
RET 0



