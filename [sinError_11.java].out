.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP
LOADSP
STOREFP
RMEM 1
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0
LOAD 0
DUP
LOADREF 0
LOADREF 0
CALL
LOADREF 1
lbl_end_main@Init: NOP
FMEM 1
STOREFP
RET 0

lbl_builder@Init: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 1



