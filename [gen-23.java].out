.DATA
VT@Main: NOP
.CODE
lbl_main@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales (2)
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo
CALL
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo
CALL
RMEM 1; reservar lugar para el retorno
SWAP
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo
CALL
STORE -1
LOAD -1
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@Main: NOP
FMEM 2; liberar espacio de variables locales (2)
STOREFP; restaurar FP
RET 0

lbl_builder@Main: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



