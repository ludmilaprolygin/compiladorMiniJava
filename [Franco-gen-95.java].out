.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Init
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@String: NOP
.CODE
lbl_builder@String: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@String: DW "String",0
.CODE
PUSH className@String
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



.DATA
VT@Character: DW lbl_charValue@Character
.CODE
lbl_charValue@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
LOADREF 2
STORE 4; guardar valor de retorno
STOREFP; restaurar FP
RET 1
lbl_end_charValue@Character: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Character: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@Character: DW "Character",0
.CODE
PUSH className@Character
LOAD 3
SWAP
STOREREF 1
LOAD 4
LOAD 3
SWAP
STOREREF 2
STOREFP; restaurar FP
RET 2



