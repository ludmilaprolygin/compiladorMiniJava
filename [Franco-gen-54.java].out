.DATA
VT@TestHerencia: DW lbl_andar@TestHerencia
.CODE
lbl_andar@TestHerencia: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 3; reservar espacio para variables locales (3)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Vehiculo
STOREREF 0
DUP
PUSH lbl_builder@Vehiculo
CALL
STORE 0; almacenar variable local (v)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Auto
STOREREF 0
DUP
PUSH lbl_builder@Auto
CALL
STORE -1; almacenar variable local (a)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@Deportivo
STOREREF 0
DUP
PUSH lbl_builder@Deportivo
CALL
STORE -2; almacenar variable local (d)
LOAD -1; cargar variable local (a)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 2; cargar metodo (acelerar)
CALL
LOAD 0; cargar variable local (v)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (frenar)
CALL
LOAD -2; cargar variable local (d)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 1; cargar metodo (acelerar)
CALL
lbl_end_andar@TestHerencia: NOP
FMEM 3; liberar espacio de variables locales (3)
STOREFP; restaurar FP
RET 1

lbl_main@TestHerencia: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 1; reservar espacio para variables locales (1)
RMEM 1
PUSH 2
PUSH simple_malloc
CALL
DUP
PUSH VT@TestHerencia
STOREREF 0
DUP
PUSH lbl_builder@TestHerencia
CALL
STORE 0; almacenar variable local (t)
LOAD 0; cargar variable local (t)
DUP; duplicar this
LOADREF 0; cargar la VT
LOADREF 0; cargar metodo (andar)
CALL
lbl_end_main@TestHerencia: NOP
FMEM 1; liberar espacio de variables locales (1)
STOREFP; restaurar FP
RET 0

lbl_builder@TestHerencia: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
.DATA
className@TestHerencia: DW "TestHerencia",0
.CODE
PUSH className@TestHerencia
LOAD 3
SWAP
STOREREF 1
STOREFP; restaurar FP
RET 1



