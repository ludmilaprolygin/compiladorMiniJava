.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Execute
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Integer: DW lbl_intValue@Integer
.CODE
lbl_intValue@Integer: 
LOADFP
LOADSP
STOREFP
LOAD 3
LOADREF 1
STORE 3
JUMP lbl_end_intValue@Integer
STORE 0
lbl_end_intValue@Integer: NOP
STOREFP
RET 1

lbl_builder@Integer: 
LOADFP
LOADSP
STOREFP
STOREFP
RET 2



