.CODE
PUSH simple_heap_init
CALL
PUSH lbl_main@Init
CALL
HALT


simple_heap_init: RET 0

simple_malloc: LOADFP
LOADSP
STOREFP
LOADHL
DUP
PUSH 1
ADD
STORE 4
LOAD 3
ADD
STOREHL
STOREFP
RET 1


.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
RMEM 2; reservar espacio para variables locales(2)
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0
PUSH 4
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP
LOADREF 0
LOADREF 0
CALL
ADD
PUSH 6
PUSH 10
PUSH 2
DIV
SUB
MUL
STORE -1
LOAD -1
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@Init: NOP
FMEM 2; liberar espacio de variables locales(2)
STOREFP; restaurar FP
RET 0

lbl_builder@Init: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



.DATA
VT@Object: NOP
.CODE
lbl_debugPrint@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
LOAD 3
IPRINT
lbl_end_debugPrint@Object: NOP
STOREFP; restaurar FP
RET 1

lbl_builder@Object: 
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
STOREFP; restaurar FP
RET 1



