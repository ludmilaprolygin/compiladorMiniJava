.DATA
VT@Init: NOP
.CODE
lbl_main@Init: 
; --- INICIO PROLOGO ---
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
; --- FIN PROLOGO ---
RMEM 2; reservar espacio para variables locales(2)
RMEM 1
PUSH 1
PUSH simple_malloc
CALL
DUP
PUSH VT@A
STOREREF 0
DUP
PUSH lbl_builder@A
CALL
STORE 0
PUSH 4
LOAD 0
RMEM 1; reservar lugar para el retorno
SWAP
DUP
LOADREF 0
LOADREF 0
CALL
ADD
PUSH 6
PUSH 10
PUSH 2
DIV
SUB
MUL
STORE -1
LOAD -1
PUSH lbl_debugPrint@Object
CALL
lbl_end_main@Init: NOP
FMEM 2; liberar espacio de variables locales(2)
; --- INICIO EPILOGO ---
STOREFP; restaurar FP
RET 0
; --- FIN EPILOGO ---

lbl_builder@Init: 
; --- INICIO PROLOGO ---
LOADFP; apilar valor de FP
LOADSP; apilar valor de SP
STOREFP; almacenar FP en el tope de la pila
; --- FIN PROLOGO ---
; --- INICIO EPILOGO ---
STOREFP; restaurar FP
RET 1
; --- FIN EPILOGO ---



